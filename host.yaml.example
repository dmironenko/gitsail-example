version: 1
installation: gitsail-example
source:
  mode: local
  path: gitsail-example
  branches:
    prod: master
    stage: dev
  poll_interval: 2s
state_dir: gitsail-example-state
age_key_file: gitsail-example.agekey
docker: {}
reconcile:
  parallelism: 4
  git_timeout: 30s
  deploy_timeout: 5m
